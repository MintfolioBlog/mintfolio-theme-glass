---
/** Series, previous/next and related posts below an article, as inset grouped lists. */
import type { PostPageData } from '@mintfolio/core/astro';
import PostRow from './PostRow.astro';
import Icon from './Icon.astro';
interface Props { page: PostPageData; language?: string; timezone?: string }
const { page, language, timezone } = Astro.props;
const series = page.post.series;
---
{series && page.seriesPosts && page.seriesPosts.length > 0 && <section class="section" aria-labelledby="series-heading">
  <h2 id="series-heading" class="section__header t-footnote">系列 · <a href={series.url}>{series.label}</a></h2>
  <ol class="grouped">
    {page.seriesPosts.map((post, index) => <li>
      <a class="row" href={post.url} aria-current={post.id === page.post.id ? 'page' : undefined}>
        <span class="row__index t-subheadline" aria-hidden="true">{index + 1}</span>
        <span class="row__label">{post.title}</span>
        {post.id === page.post.id ? <Icon name="checkmark" class="row__check" label="正在阅读" /> : <Icon name="chevron.right" class="row__chevron" />}
      </a>
    </li>)}
  </ol>
</section>}

{(page.previous || page.next) && <nav class="section" aria-label="相邻文章">
  <ul class="grouped">
    {page.previous && <li><a class="row row--two-line" href={page.previous.url} rel="prev">
      <Icon name="chevron.left" class="row__icon" />
      <span class="row__stack"><span class="row__caption t-footnote">上一篇</span><span class="row__label">{page.previous.title}</span></span>
    </a></li>}
    {page.next && <li><a class="row row--two-line" href={page.next.url} rel="next">
      <span class="row__stack"><span class="row__caption t-footnote">下一篇</span><span class="row__label">{page.next.title}</span></span>
      <Icon name="chevron.right" class="row__chevron" />
    </a></li>}
  </ul>
</nav>}

{page.related && page.related.length > 0 && <section class="section related" aria-labelledby="related-heading">
  <h2 id="related-heading" class="section__title t-title2">继续阅读</h2>
  <ul class="grouped post-list">
    {page.related.map((post) => <PostRow post={post} language={language} timezone={timezone} />)}
  </ul>
</section>}
