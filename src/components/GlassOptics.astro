<script>
  import { onPage } from '@mintfolio/core/client';

  onPage('body', (body, scope) => {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const transparency = matchMedia('(prefers-reduced-transparency: reduce)');
    const contrast = matchMedia('(prefers-contrast: more)');
    const colors = matchMedia('(forced-colors: active)');
    const compact = matchMedia('(max-width: 37.49rem)');
    let lens: HTMLElement | undefined;
    let navigation: HTMLElement | undefined;
    let disposed = false; let revision = 0;
    let loaded = false; let rippleTimer: ReturnType<typeof setTimeout> | undefined;
    let importing: Promise<unknown> | undefined;

    /** Mount one visible optical surface; disconnecting frees library GPU/listener resources. */
    async function update() { const request = ++revision;
      const enabled = document.documentElement.dataset.transparency === 'on'
        && !transparency.matches && !contrast.matches && !colors.matches;
      lens?.remove();
      navigation?.removeAttribute('data-refraction');
      lens = undefined;
      if (!enabled || disposed) return;
      importing ??= import('simple-liquid-glass/web-component');
      try { await importing; loaded = true; } catch { return; }
      if (disposed || !loaded || request !== revision) return;
      // The revision guard above prevents stale imports from mounting duplicate renderers.
      navigation = body.querySelector<HTMLElement>(compact.matches ? '.mobile-navigation' : '.desktop-navigation') ?? undefined;
      if (!navigation || !navigation.getClientRects().length) return;
      const surface = document.createElement('liquid-glass');
      surface.className = 'optical-surface';
      surface.setAttribute('aria-hidden', 'true');
      surface.setAttribute('radius', '36');
      surface.setAttribute('frost', '0.18');
      surface.setAttribute('blur', '1.2');
      // A low-amplitude directional map bends at the boundary without the rim
      // map's folded/repeated text. Keep press turbulence below one CSS pixel.
      surface.setAttribute('scale', '8');
      surface.setAttribute('lens', 'shift');
      surface.setAttribute('lens-strength', '0.5');
      surface.setAttribute('angle', '65');
      surface.setAttribute('saturation', '125');
      surface.setAttribute('border-color', 'rgba(255,255,255,0.8)');
      surface.setAttribute('strength', '0.035');
      surface.setAttribute('dispersion', '0.015');
      surface.setAttribute('lens-profile', 'player');
      // Chromium refracts the live backdrop using SVG. Other engines use the
      // library's WebGL source capture; password pages never enter capture.
      const chromium = /Chrome|Chromium|Edg|OPR/.test(navigator.userAgent) && !/iPhone|iPad|iPod/.test(navigator.userAgent);
      if (!chromium && document.documentElement.dataset.glassCapture === 'on' && !reduced.matches) {
        surface.setAttribute('renderer', 'webgl');
        surface.setAttribute('backdrop-selector', '#main-content');
      } else if (!chromium) {
        surface.setAttribute('effect-mode', 'blur');
      }
      navigation.prepend(surface);
      lens = surface;
      navigation.dataset.refraction = 'on';
    }
    for (const query of [reduced, transparency, contrast, colors, compact]) {
      query.addEventListener('change', update, { signal: scope.signal });
    }
    body.addEventListener('pointerdown', (event) => {
      if (reduced.matches || !lens || lens.dataset.glassStrategy !== 'svg'
        || !(event.target instanceof Node) || !navigation?.contains(event.target)) return;
      lens.setAttribute('liquid-scale', '0.5');
      lens.setAttribute('liquid', 'ripple');
      clearTimeout(rippleTimer);
      rippleTimer = setTimeout(() => lens?.removeAttribute('liquid'), 320);
    }, { signal: scope.signal });
    // Prefer matching system preferences without polling or perpetual animation.
    const observer = new MutationObserver(update);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-transparency'] });
    scope.signal.addEventListener('abort', () => {
      disposed = true; clearTimeout(rippleTimer); observer.disconnect(); lens?.remove();
      navigation?.removeAttribute('data-refraction');
    }, { once: true });
    void update();
  });
</script>