---
import type { PostSummary } from '@mintfolio/core/theme';
interface Props {
  /** Public metadata only; protected bodies are never read by this component. */
  post: PostSummary;
  language?: string;
  timezone?: string;
  compact?: boolean;
}
const { post, language = 'zh-CN', timezone = 'UTC', compact = false } = Astro.props;
const date = (value: string): string => new Intl.DateTimeFormat(language, { year: 'numeric', month: 'short', day: 'numeric', timeZone: timezone }).format(new Date(value));
---
<div class="post-meta">
  <time datetime={post.publishedAt}>{date(post.publishedAt)}</time>
  {post.readingMinutes !== undefined && <span>{post.readingMinutes} 分钟阅读</span>}
  {!compact && post.wordCount !== undefined && <span>{new Intl.NumberFormat(language).format(post.wordCount)} 字</span>}
  {!compact && post.updatedAt && <span>更新于 <time datetime={post.updatedAt}>{date(post.updatedAt)}</time></span>}
  {!compact && post.authors && post.authors.length > 0 && <span class="post-authors">
    {post.authors.map((author, index) => <Fragment>{index > 0 && ' / '}{author.url ? <a href={author.url}>{author.name}</a> : author.name}</Fragment>)}
  </span>}
  {post.preview && <span class="state-label">本地预览</span>}
  {post.protected && <span class="state-label">受保护</span>}
</div>