---
import type { PageProps } from '@mintfolio/core/astro';
import type { GlassSettings } from '../settings';
interface Props extends PageProps<GlassSettings> {}
const { theme, page } = Astro.props;
const home = theme.urls.home();
const archive = theme.urls.archive();
---
<nav class="desktop-navigation" aria-label="网站导航">
  {theme.navigation.map((link) => <a href={link.url} aria-current={link.url === page.url ? 'page' : undefined}>{link.label}</a>)}
</nav>
<nav class="mobile-navigation" aria-label="网站导航">
  <a href={home} aria-current={page.url === home ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v11h-6v-7H9v7H3Z" /></svg><span>首页</span>
  </a>
  <a href={archive} aria-current={page.url === archive ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="3" /><path d="M8 8h8M8 12h8M8 16h5" /></svg><span>文章</span>
  </a>
  <details class="navigation-more">
    <summary><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg><span>更多</span></summary>
    <div class="navigation-sheet">
      <p class="eyebrow">探索网站</p>
      {theme.navigation.map((link) => <a href={link.url} aria-current={link.url === page.url ? 'page' : undefined}>{link.label}</a>)}
      <a href={archive + '#site-search'}>搜索文章</a>
      <a href={theme.urls.rss()}>订阅 RSS</a>
    </div>
  </details>
</nav>
<script>
  import { onPage } from '@mintfolio/core/client';
  // Native details remains usable without JS; enhancement adds conventional
  // Escape/outside dismissal. Core releases listeners on page disposal.
  onPage('.navigation-more', (root, scope) => {
    const details = root as HTMLDetailsElement;
    const summary = details.querySelector('summary');
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) {
        details.open = false;
        summary?.focus();
      }
    }, { signal: scope.signal });
    document.addEventListener('pointerdown', (event) => {
      if (details.open && event.target instanceof Node && !details.contains(event.target)) {
        details.open = false;
      }
    }, { signal: scope.signal });
  });
</script>