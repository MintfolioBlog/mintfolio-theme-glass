---
import type { ListPageData, PageProps } from '@mintfolio/core/astro';
import SearchPanel from '@mintfolio/core/components/SearchPanel.astro';
import Pagination from '@mintfolio/core/components/Pagination.astro';
import type { GlassSettings } from '../settings';
import GlassLayout from '../layouts/GlassLayout.astro';
import PostRow from '../components/PostRow.astro';

interface Props extends PageProps<GlassSettings, ListPageData> {}
const { theme, page } = Astro.props;
const [tags, categories, series] = await Promise.all([theme.taxonomy.tags(), theme.taxonomy.categories(), theme.taxonomy.series()]);
const offset = page.pagination ? (page.pagination.current - 1) * page.pagination.pageSize : 0;
---
<GlassLayout theme={theme} page={page}>
  <div class="shell inner-page">
    <header class="archive-heading page-heading">
      <div><p class="eyebrow">全部记录</p><h1>{page.title}<span class="accent-dot" aria-hidden="true">.</span></h1><p class="page-description">{page.description}</p></div>
      <p class="archive-total"><strong>{String(page.pagination?.totalItems ?? page.posts.length).padStart(2, '0')}</strong><span>篇记录</span></p>
    </header>
    <div class="archive-workspace">
      <aside class="archive-sidebar" aria-label="搜索和内容分类">
        <div class="search-station" id="site-search"><p class="eyebrow">搜索与探索</p><SearchPanel placeholder="搜索文章…" /></div>
        <nav class="taxonomy-navigation" aria-label="文章分类">
          <a class="taxonomy-all" href={theme.urls.archive()} aria-current={!page.taxonomy ? 'page' : undefined}>全部文章 <span aria-hidden="true">↗</span></a>
          {categories.length > 0 && <div class="taxonomy-group"><h2>分类 <span>CATEGORIES</span></h2>{categories.map((term) => <a href={term.url} aria-current={page.taxonomy?.kind === 'category' && page.taxonomy.label === term.label ? 'page' : undefined}><span>{term.label}</span><small>{term.count}</small></a>)}</div>}
          {tags.length > 0 && <div class="taxonomy-group"><h2>标签 <span>TOPICS</span></h2><div class="topic-links">{tags.map((term) => <a href={term.url} aria-current={page.taxonomy?.kind === 'tag' && page.taxonomy.label === term.label ? 'page' : undefined}>#{term.label}</a>)}</div></div>}
          {series.length > 0 && <div class="taxonomy-group"><h2>系列 <span>SERIES</span></h2>{series.map((term) => <a href={term.url} aria-current={page.taxonomy?.kind === 'series' && page.taxonomy.label === term.label ? 'page' : undefined}><span>{term.label}</span><small>{term.count}</small></a>)}</div>}
        </nav>
      </aside>
      <section class="archive-list" aria-label="本页文章">
        {page.posts.length > 0 ? <div class="post-rows">{page.posts.map((post, index) => <PostRow post={post} number={offset + index + 1} language={theme.site.language} timezone={theme.site.blog?.timezone} heading="h2" />)}</div>
          : <p class="empty-caption">这个分类还没有文章。</p>}
        {page.pagination && <Pagination pagination={page.pagination} />}
      </section>
    </div>
  </div>
</GlassLayout>