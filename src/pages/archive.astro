---
import type { ListPageData, PageProps } from '@mintfolio/core/astro';
import SearchPanel from '@mintfolio/core/components/SearchPanel.astro';
import Pagination from '@mintfolio/core/components/Pagination.astro';
import type { GlassSettings } from '../settings';
import GlassLayout from '../layouts/GlassLayout.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';

interface Props extends PageProps<GlassSettings, ListPageData> {}
const { theme, page } = Astro.props;
const [tags, categories, series] = await Promise.all([theme.taxonomy.tags(), theme.taxonomy.categories(), theme.taxonomy.series()]);
const total = page.pagination?.totalItems ?? page.posts.length;
const selected = (kind: 'tag' | 'category' | 'series', label: string): boolean => page.taxonomy?.kind === kind && page.taxonomy.label === label;
const eyebrow = page.taxonomy ? { tag: '标签', category: '分类', series: '系列' }[page.taxonomy.kind] : '全部文章';
---
<GlassLayout theme={theme} page={page}>
  <div class="page">
    <header class="page-header">
      <p class="page-header__eyebrow t-footnote">{eyebrow} · {total} 篇</p>
      <h1 class="page-header__title t-large-title" data-large-title>{page.title}</h1>
      {page.description && <p class="page-header__supporting t-body">{page.description}</p>}
    </header>

    <div class="filters">
      <div class="search-block" id="site-search"><SearchPanel placeholder="搜索" /></div>
      <nav aria-label="分类">
        <ul class="segmented">
          <li><a href={theme.urls.archive()} aria-current={!page.taxonomy ? 'page' : undefined}>全部</a></li>
          {categories.map((term) => <li><a href={term.url} aria-current={selected('category', term.label) ? 'page' : undefined}>{term.label}<small>{term.count}</small></a></li>)}
        </ul>
      </nav>
      {tags.length > 0 && <nav aria-label="标签">
        <ul class="capsule-set">
          {tags.map((term) => <li><a class="capsule" href={term.url} aria-current={selected('tag', term.label) ? 'page' : undefined}>{term.label}</a></li>)}
        </ul>
      </nav>}
    </div>

    <section class="section" aria-label="本页文章">
      {page.posts.length > 0
        ? <ul class="grouped post-list">{page.posts.map((post) => <PostRow post={post} heading="h2" language={theme.site.language} timezone={theme.site.blog?.timezone} />)}</ul>
        : <ul class="grouped"><li class="row"><span class="row__label secondary">这里还没有文章。</span></li></ul>}
      {page.pagination && <Pagination pagination={page.pagination} />}
    </section>

    {series.length > 0 && <section class="section" aria-labelledby="series-heading">
      <h2 id="series-heading" class="section__header t-footnote">系列</h2>
      <ul class="grouped" style="--separator-inset: 48px">
        {series.map((term) => <li><a class="row" href={term.url} aria-current={selected('series', term.label) ? 'page' : undefined}>
          <Icon name="book" class="row__icon" /><span class="row__label">{term.label}</span><span class="row__value">{term.count}</span><Icon name="chevron.right" class="row__chevron" />
        </a></li>)}
      </ul>
    </section>}
  </div>
</GlassLayout>
