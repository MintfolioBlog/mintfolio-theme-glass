---
import type { PageProps, PostPageData } from '@mintfolio/core/astro';
import Image from '@mintfolio/core/components/Image.astro';
import ProtectedArticle from '@mintfolio/core/components/ProtectedArticle.astro';
import type { GlassSettings } from '../settings';
import GlassLayout from '../layouts/GlassLayout.astro';
import Meta from '../components/Meta.astro';
import ArticleConnections from '../components/ArticleConnections.astro';

interface Props extends PageProps<GlassSettings, PostPageData> {}
const { theme, page } = Astro.props;
const protectedBody = page.body.kind === 'protected' ? page.body : undefined;
const headings = page.body.kind === 'public' ? page.body.headings.filter((heading) => heading.depth <= 3) : [];
---
<GlassLayout theme={theme} page={page}>
  <div class="shell inner-page article-page">
    <a class="back-link" href={theme.urls.archive()}>← 返回文章归档</a>
    <header class="article-heading">
      <p class="eyebrow"><a href={page.post.category.url}>{page.post.category.label}</a>{page.post.pinned && <span class="state-label">置顶</span>}</p>
      <h1>{page.post.title}</h1>
      <p class="article-deck">{page.post.description}</p>
      <Meta post={page.post} language={theme.site.language} timezone={theme.site.blog?.timezone} />
      {page.post.tags.length > 0 && <nav class="article-tags" aria-label="文章标签">{page.post.tags.map((tag) => <a href={tag.url}>#{tag.label}</a>)}</nav>}
    </header>
    {page.post.cover && <div class="article-cover"><Image src={page.post.cover} alt="" width={1600} height={900} loading="eager" /></div>}
    <div class:list={['reading-layout', { 'with-toc': headings.length > 0 }]}>
      <article class="article-body">
        {page.body.kind === 'public' ? <div class="prose" set:html={page.body.html} />
          : protectedBody && <div class="prose"><ProtectedArticle body={protectedBody} /></div>}
      </article>
      {headings.length > 0 && <aside class="article-sidebar">
        <details class="article-toc" open>
          <summary>本页目录</summary>
          <nav aria-label="文章目录"><ol>{headings.map((heading) => <li class:list={{ 'toc-nested': heading.depth > 2 }}><a href={'#' + encodeURIComponent(heading.slug)}>{heading.text}</a></li>)}</ol></nav>
        </details>
      </aside>}
    </div>
    <ArticleConnections page={page} language={theme.site.language} timezone={theme.site.blog?.timezone} />
  </div>
</GlassLayout>