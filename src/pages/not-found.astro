---
import type { NotFoundPageData, PageProps } from '@mintfolio/core/astro';
import SearchPanel from '@mintfolio/core/components/SearchPanel.astro';
import type { GlassSettings } from '../settings';
import GlassLayout from '../layouts/GlassLayout.astro';

interface Props extends PageProps<GlassSettings, NotFoundPageData> {}
const { theme, page } = Astro.props;
---
<GlassLayout theme={theme} page={page}>
  <section class="shell not-found">
    <p class="eyebrow">页面未找到</p>
    <div class="lost-number" aria-hidden="true">4<span>0</span>4</div>
    <h1>{page.title || '暂时找不到这个页面'}</h1>
    <p>这个地址没有对应的页面。可以返回首页，或者搜索你想读的内容。</p>
    <div class="hero-actions"><a class="primary-link" href={theme.urls.home()}>返回首页 <span aria-hidden="true">↗</span></a><a class="quiet-link" href={theme.urls.archive()}>浏览文章 →</a></div>
    <div class="lost-search"><SearchPanel /></div>
  </section>
</GlassLayout>