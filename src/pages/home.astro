---
import type { HomePageData, PageProps } from '@mintfolio/core/astro';
import Image from '@mintfolio/core/components/Image.astro';
import type { GlassSettings } from '../settings';
import GlassLayout from '../layouts/GlassLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PostRow from '../components/PostRow.astro';
import Button from '../components/Button.astro';
interface Props extends PageProps<GlassSettings, HomePageData> {}
const { theme, page } = Astro.props;
const [feature, ...rest] = page.posts;
const recent = rest.slice(0, 6);
const language = theme.site.language;
const timezone = theme.site.blog?.timezone;
// The large title defaults to the site slogan; a custom title moves the slogan below it.
const heroTitle = theme.settings.heroTitle || theme.site.description || theme.site.title;
const heroDescription = theme.settings.heroDescription || (theme.settings.heroTitle ? theme.site.description : '');
---
<GlassLayout theme={theme} page={page} title={theme.site.title}>
  <div class="page">
    <header class="page-header">
      {theme.settings.heroEyebrow && <p class="page-header__eyebrow t-footnote">{theme.settings.heroEyebrow}</p>}
      <div class="page-header__row">
        <h1 class="page-header__title t-large-title" data-large-title>{heroTitle}</h1>
        <a class="avatar-link" href={theme.urls.page('about')} aria-label={`关于 ${theme.site.profile.name}`}>
          <Image src={theme.site.profile.avatar} alt="" width={80} height={80} />
        </a>
      </div>
      {heroDescription && <p class="page-header__supporting t-body">{heroDescription}</p>}
      <div class="button-row">
        <Button href={theme.urls.archive()} variant="prominent" trailingIcon="chevron.right">浏览文章</Button>
        <Button href={theme.urls.archive() + '#site-search'} variant="bordered" icon="search">搜索</Button>
      </div>
    </header>

    {feature
      ? <FeatureCard post={feature} eyebrow={feature.pinned ? '置顶' : '最新'} language={language} timezone={timezone} />
      : <ul class="grouped"><li class="row"><span class="row__label">第一篇文章，即将到来。</span></li></ul>}

    {recent.length > 0 && <section class="section" aria-labelledby="latest-heading">
      <div class="section__head">
        <h2 id="latest-heading" class="section__title t-title2">最近更新</h2>
        <Button href={theme.urls.archive()} variant="plain">查看全部</Button>
      </div>
      <ul class="grouped post-list">
        {recent.map((post) => <PostRow post={post} language={language} timezone={timezone} />)}
      </ul>
    </section>}
  </div>
</GlassLayout>
